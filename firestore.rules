rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'admin';
    }

    function validStatus() {
      return request.resource.data.status in [
        'Pending', 'In Progress', 'Resolved'
      ];
    }

    function validReceiptData() {
      let receipt = request.resource.data.get('receiptPdfData', '');
      return receipt is string && receipt.size() <= 700000 &&
        (receipt == '' || receipt.matches('data:application/pdf;base64,[A-Za-z0-9+/=]+'));
    }

    function validCollectionData() {
      let amount = request.resource.data.get('collectedAmount', 0);
      let collectedAt = request.resource.data.get('collectedAt', null);
      return amount is number && amount >= 0 &&
        (collectedAt == null || collectedAt is timestamp);
    }

    match /users/{userId} {
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'resident';

      allow read: if signedIn() &&
        (request.auth.uid == userId || isAdmin());

      allow update: if isAdmin() ||
        (signedIn() &&
         request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['fullName', 'purok', 'contactNumber', 'profilePhoto']) &&
         request.resource.data.get('profilePhoto', resource.data.get('profilePhoto', '')) is string &&
         request.resource.data.get('profilePhoto', resource.data.get('profilePhoto', '')).size() <= 600000 &&
         (request.resource.data.get('profilePhoto', resource.data.get('profilePhoto', '')) == '' ||
          request.resource.data.get('profilePhoto', resource.data.get('profilePhoto', ''))
            .matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')));

      allow delete: if isAdmin();
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      allow create, update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasAll(['token', 'platform', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt']) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() <= 4096 &&
        request.resource.data.platform in ['android', 'web'] &&
        request.resource.data.updatedAt is timestamp;

      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /requests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.submittedByUid == request.auth.uid &&
        request.resource.data.status == 'Pending';

      allow read: if signedIn() &&
        (resource.data.submittedByUid == request.auth.uid || isAdmin());

      // Staff may edit requests at any status, preserving resident ownership.
      // Residents may edit only their own pending title and description.
      allow update: if
        (isAdmin() &&
         validStatus() &&
         validReceiptData() &&
         validCollectionData() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'receiptPdfData', 'receiptFeeAmount', 'receiptFeeDescription', 'receiptIssuedAt', 'collectedAmount', 'collectedAt']) &&
         request.resource.data.submittedByUid == resource.data.submittedByUid)
        ||
        (signedIn() &&
         resource.data.submittedByUid == request.auth.uid &&
         resource.data.status == 'Pending' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['title', 'description']));

      allow delete: if isAdmin() ||
        (signedIn() &&
         resource.data.submittedByUid == request.auth.uid &&
         resource.data.status == 'Pending');
    }

    match /chats/{residentUid} {
      function isConversationResident() {
        return signedIn() && request.auth.uid == residentUid;
      }

      allow create: if isConversationResident() &&
        request.resource.data.keys().hasAll([
          'residentUid', 'residentName', 'createdAt', 'updatedAt',
          'lastMessage', 'lastSenderUid'
        ]) &&
        request.resource.data.keys().hasOnly([
          'residentUid', 'residentName', 'createdAt', 'updatedAt',
          'lastMessage', 'lastSenderUid'
        ]) &&
        request.resource.data.residentUid == request.auth.uid &&
        request.resource.data.residentName is string &&
        request.resource.data.residentName.size() > 0 &&
        request.resource.data.residentName.size() <= 200 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.lastMessage == '' &&
        request.resource.data.lastSenderUid == '';

      allow read: if isAdmin() || isConversationResident();

      allow update: if (isAdmin() || isConversationResident()) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt']) &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessage.size() > 0 &&
        request.resource.data.lastMessage.size() <= 2000 &&
        request.resource.data.lastSenderUid == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.residentUid == resource.data.residentUid &&
        request.resource.data.residentName == resource.data.residentName;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin() ||
          (signedIn() && request.auth.uid == residentUid);

        allow create: if signedIn() &&
          exists(/databases/$(database)/documents/chats/$(residentUid)) &&
          (isAdmin() || request.auth.uid == residentUid) &&
          request.resource.data.keys().hasAll([
            'senderUid', 'senderName', 'text', 'createdAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'senderUid', 'senderName', 'text', 'createdAt'
          ]) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.senderName is string &&
          request.resource.data.senderName.size() > 0 &&
          request.resource.data.senderName.size() <= 200 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    match /transparencyPosts/{postId} {
      function validPost() {
        let post = request.resource.data;
        // Older posts without imageData remain valid.
        let image = post.get('imageData', '');
        return post.keys().hasAll([
            'title', 'category', 'description',
            'publishedBy', 'publishedByUid', 'createdAt',
            'attachmentName', 'attachmentPath'
          ]) &&
          post.keys().hasOnly([
            'title', 'category', 'description',
            'publishedBy', 'publishedByUid', 'createdAt',
            'attachmentName', 'attachmentPath', 'imageData'
          ]) &&
          post.title is string &&
          post.title.size() > 0 && post.title.size() <= 150 &&
          post.description is string &&
          post.description.size() > 0 && post.description.size() <= 10000 &&
          post.category in [
            'Budget & Finances', 'Projects', 'Procurement', 'Reports', 'Other'
          ] &&
          post.publishedBy is string && post.publishedBy.size() <= 200 &&
          post.publishedByUid is string &&
          post.createdAt is timestamp &&
          post.attachmentName is string && post.attachmentName.size() <= 255 &&
          post.attachmentPath is string &&
          (post.attachmentPath == '' ||
           post.attachmentPath == 'transparency/' + postId + '/attachment') &&
          image is string && image.size() <= 820000 &&
          (image == '' ||
           (post.attachmentPath == '' &&
            image.matches('data:image/(jpeg|png);base64,[A-Za-z0-9+/=]+')));
      }

      allow read: if signedIn();

      allow create: if isAdmin() && validPost() &&
        request.resource.data.publishedByUid == request.auth.uid &&
        request.resource.data.createdAt == request.time;

      allow update: if isAdmin() && validPost() &&
        request.resource.data.publishedByUid == resource.data.publishedByUid &&
        request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAdmin();
    }
  }
}
